# Required. At least 32 characters. Generate with: openssl rand -hex 32
ADMIN_KEY=change-me-to-a-long-random-string-min-32-chars
# Optional. Used to sign session tokens. If empty, a random one is generated at boot (sessions reset on restart).
SESSION_SECRET=
PORT=8080
DB_PATH=./data/crondeck.db
# development | production (production sets the Secure cookie flag and JSON logs)
APP_ENV=development
TZ_DEFAULT=UTC
MAX_CONCURRENT_RUNS=10
MAX_OUTPUT_BYTES=65536
RUN_RETENTION_DAYS=30
# Set to false to disable shell and script job types
ALLOW_SHELL=true
# SQL jobs (sqlite/postgres connection string in job config). On by default.
ALLOW_SQL=true
SESSION_TTL_HOURS=24
# Dev only: origin of the Next.js dev server
CORS_ORIGIN=http://localhost:3000
# Defaults to true when APP_ENV=production. Set false only if you serve over plain HTTP (not localhost).
# COOKIE_SECURE=true
# Set to true only when running behind a trusted reverse proxy (uses X-Forwarded-For for client IP)
TRUST_PROXY=false
# Expose Prometheus metrics at GET /metrics (no auth; protect at the network edge)
METRICS_ENABLED=true
# Optional default failure webhook (overridden by Settings → Failure notifications)
# ALERT_WEBHOOK_URL=https://example.com/hooks/crondeck

# Docker Compose overrides (optional)
# CRONDECK_IMAGE=ghcr.io/your-owner/your-repository:latest
# BIND_ADDRESS=127.0.0.1
# EXTRA_PACKAGES=python3 postgresql-client curl
